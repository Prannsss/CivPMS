# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the app (used in email links and auth redirects)
APP_URL=http://localhost:3000

# Supabase (Project Settings -> API). URL and publishable key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://bxfohhwvzbvmyokcsmwq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed to send notification emails from the outbox. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Brevo transactional email (server only). Use the raw "xkeysib-..." API key.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CivPMS
# true = Brevo validates requests but drops them (no real emails). Use in dev/test.
BREVO_SANDBOX=false

# Protects /api/cron/* routes (Authorization: Bearer <CRON_SECRET>). Vercel Cron sends it automatically.
# Any long random string, e.g. the output of: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
CRON_SECRET=

# Dev/test only: password of the seeded demo accounts used by local demos and e2e tests.
# Ignored on Vercel production deployments. Leave empty unless you seed demo data.
DEMO_PASSWORD=
