# civpms-media configuration (placeholders only; see README.md → Configuration).
# Copy to backend/.env for `docker run --env-file`; never commit real values.

# Required
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key. Secret/service-role keys are refused.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Exact origins of the web app, comma separated (no wildcards, no trailing slash).
APP_ORIGINS=http://localhost:3000

# Optional
PORT=8080
# Without it the service runs with in-memory cache/rate limits (single instance only).
REDIS_URL=redis://127.0.0.1:6379
MAX_UPLOAD_MB=15
MAX_IMAGE_PIXELS=50000000
# Estimated decoder memory per image (16-bit/alpha/progressive sources need more).
MAX_DECODE_MB=200
FFMPEG_CONCURRENCY=2
FFMPEG_TIMEOUT_SECS=30
FFMPEG_QUEUE_TIMEOUT_SECS=20
# Uploads in progress per instance (default 4 x FFMPEG_CONCURRENCY, at least 8); one per user.
MAX_CONCURRENT_UPLOADS=8
# Per user; uploads also cost one unit per second of ffmpeg processing.
RATE_LIMIT_UPLOADS_PER_MIN=30
AVATAR_BUCKET=avatars
MEDIA_BUCKET=project-media
# Keep-alive self-ping (opt-in; read README.md → Keep-alive before turning it on).
KEEPALIVE_ENABLED=false
KEEPALIVE_IDLE_SECS=840
# KEEPALIVE_URL defaults to ${RENDER_EXTERNAL_URL}/healthz on Render.
LOG_FORMAT=pretty
RUST_LOG=info
